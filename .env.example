# ─── Copia este archivo a .env.local para desarrollo. NUNCA subas .env.local ───

# Nombre visible del taller (el admin también puede cambiarlo desde la app).
NEXT_PUBLIC_TALLER_NAME="Procesos productivos S.M.I."
TALLER_TIMEZONE="America/Bogota"

# Backend de datos: github | file | memory
#   file   → archivos JSON en .data/ (desarrollo local, por defecto sin token)
#   memory → demo en memoria (se reinicia)
#   github → repositorio PRIVADO como base de datos (producción)
DATA_BACKEND=file
# Con DATA_BACKEND=memory se cargan datos ficticios de demostración (off para desactivar).
DEMO_SEED=on

# Repositorio privado de datos (solo producción). Token fine-grained con
# acceso SOLO a ese repo y permiso "Contents: Read and write".
GITHUB_DATA_REPO="pairx-pair/smi-taller-data"
GITHUB_DATA_TOKEN=""
GITHUB_DATA_BRANCH="main"

# Firma de sesiones: mínimo 32 caracteres aleatorios.  openssl rand -base64 48
SESSION_SECRET=""

# Clave para crear el PRIMER administrador en /setup (mín. 16 caracteres).
# Bórrala de Vercel después de crear el admin.
SETUP_KEY=""

# Notificaciones push (npm run vapid genera el par de claves).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# URL pública (para enlaces en notificaciones push). Ej: https://smi-taller.vercel.app
APP_URL=""
# Orígenes extra permitidos para peticiones (dominio propio), separados por coma.
APP_ORIGINS=""

# Administrador declarado en el entorno (alternativa a /setup). Se crea la primera vez que alguien
# inicia sesión con ese usuario. Nunca pongas la contraseña aquí: solo su hash scrypt.
#   echo "tu frase segura" | npm run --silent hash-password
# En archivos .env cada "$" del hash se escribe "\$" (el script ya lo imprime así); en Vercel, tal cual.
# Borra estas variables después del primer inicio de sesión.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_NAME=""
ADMIN_BOOTSTRAP_PASSWORD_HASH=""
# Más administradores: ADMIN_BOOTSTRAP_2_USERNAME / _2_NAME / _2_PASSWORD_HASH (hasta _5_).
#   echo "otra frase" | npm run --silent hash-password -- ADMIN_BOOTSTRAP_2_PASSWORD_HASH

# Vercel Cron (recordatorios y cierre automático): mínimo 16 caracteres aleatorios.
CRON_SECRET=""

# App Android (assetlinks.json): paquete y huella SHA-256 del certificado de firma (son públicos).
ANDROID_PACKAGE_ID="co.smi.procesos"
ANDROID_CERT_SHA256=""
